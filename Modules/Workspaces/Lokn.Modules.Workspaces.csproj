<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- This module's release version; raise it to publish the module as an update (scripts/release.ps1). -->
		<Version>1.7.5</Version>
	</PropertyGroup>
	<ItemGroup>
		<!-- The sidebar's faces, Fraunces, under the SIL Open Font License beside them. -->
		<EmbeddedResource Include="Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
		<None Include="Fonts\OFL-*.txt" />
		<!-- The fade at the end of long titles, compiled from the .slang beside it by scripts/shaders.ps1 and committed; SidebarFade loads it. -->
		<EmbeddedResource Include="Shaders\*.goo-effect" LogicalName="Lokn.Workspaces.%(Filename).goo-effect" />
	</ItemGroup>
</Project>
