<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- This module's release version; raise it to publish the module as an update (scripts/release.ps1). -->
		<Version>2.9.0</Version>
		<!-- Windows.Graphics.Capture reaches IGraphicsCaptureItemInterop through its vtable. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<!-- The host gateway serves the Conversations module's chats and the Projects module's store; Omp supplies the sessions behind them. -->
		<ProjectReference Include="..\Conversations\Lokn.Modules.Conversations.csproj" Private="false" />
		<ProjectReference Include="..\Projects\Lokn.Modules.Projects.csproj" Private="false" />
		<ProjectReference Include="..\Omp\Lokn.Modules.Omp.csproj" Private="false" />
		<!-- The stream panel captures windows with the Windows SDK projection, which the application ships (Lokn.csproj), so the module never carries its own copy. -->
		<PackageReference Include="Microsoft.Windows.SDK.NET.Ref" Version="10.0.19041.87" ExcludeAssets="all" GeneratePathProperty="true" PrivateAssets="all" />
		<Reference Include="$(PkgMicrosoft_Windows_SDK_NET_Ref)\lib\net9.0\Microsoft.Windows.SDK.NET.dll" Private="false" />
		<Reference Include="$(PkgMicrosoft_Windows_SDK_NET_Ref)\lib\net9.0\WinRT.Runtime.dll" Private="false" />
	</ItemGroup>
	<ItemGroup>
		<!-- The web client's files, which WebClientAssets serves by these names; its icon is the brand's. -->
		<EmbeddedResource Include="Web\Assets\*" LogicalName="web/%(Filename)%(Extension)" />
		<EmbeddedResource Include="..\..\assets\brand\loom-256.png" LogicalName="web/icon.png" />
	</ItemGroup>
</Project>
