<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- This module's release version; raise it to publish the module as an update (scripts/release.ps1). -->
		<Version>1.2.0</Version>
	</PropertyGroup>
	<ItemGroup>
		<!-- The brief's faces, Fraunces roman and italic, under the SIL Open Font License beside them. -->
		<EmbeddedResource Include="Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
		<None Include="Fonts\OFL-*.txt" />
		<!-- The brief's paintings, one per weekday: public domain works from the National Gallery of Denmark (SMK). -->
		<EmbeddedResource Include="Paintings\*.jpg" LogicalName="Paintings.%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Conversations\Lokn.Modules.Conversations.csproj" Private="false" />
		<ProjectReference Include="..\Browser\Lokn.Modules.Browser.csproj" Private="false" />
	</ItemGroup>
</Project>
