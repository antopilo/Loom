<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- WindowIcon uses LibraryImport, whose generated marshalling needs unsafe code. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Product name is Loom; namespaces and project names keep the code name Lokn. -->
		<AssemblyName>Loom</AssemblyName>
		<RootNamespace>Lokn</RootNamespace>
		<ApplicationIcon>assets\brand\loom.ico</ApplicationIcon>
		<!-- The release version: the installer's package version, and the version Program reports to Goo. Raise it for every release. -->
		<Version>0.4.12</Version>
		<!-- A publish (scripts/publish.ps1, the installer) precompiles Loom, Core, Goo and their libraries to native code, so starting Loom compiles
		     about 6,000 fewer methods before its first frame (docs/performance.md#startup). Modules gain nothing from it: they load from their bytes
		     (Shell/ModuleHost.cs), where the runtime ignores precompiled code, so they stay IL. -->
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>
	<ItemGroup>
		<!-- Lets the GC compact the large-object heap once it is fragmented: chats churn through large JSON and image buffers, which otherwise left
		     over 150 MB of free gaps in a long-running window. 0 is off, 9 is most aggressive; 5 trades a little GC time for that memory. -->
		<RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
		<!-- Libraries Loom only loads on demand, and the largest ones: precompiling the Windows SDK projection alone would add 30 MB to the install. -->
		<PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll;WinRT.Runtime.dll;Tmds.DBus.Protocol.dll" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<!-- Installs, updates and uninstalls Loom; see scripts/installer.ps1. Keep it at the version of the vpk tool in dotnet-tools.json. -->
		<PackageReference Include="Velopack" Version="1.2.161" />
		<!-- Ships WebView2's core API and native loader with the application, since a module cannot bring its own packages; the Browser module uses them.
		     The package's own build targets are skipped because they also reference its WPF and WinForms controls. -->
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" ExcludeAssets="all" GeneratePathProperty="true" PrivateAssets="all" />
		<Reference Include="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll" />
		<None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<!-- Ships the Windows SDK projection, which source modules such as the community Now Playing module use for Windows APIs, for the same reason. -->
		<PackageReference Include="Microsoft.Windows.SDK.NET.Ref" Version="10.0.19041.87" ExcludeAssets="all" GeneratePathProperty="true" PrivateAssets="all" />
		<Reference Include="$(PkgMicrosoft_Windows_SDK_NET_Ref)\lib\net9.0\Microsoft.Windows.SDK.NET.dll" />
		<Reference Include="$(PkgMicrosoft_Windows_SDK_NET_Ref)\lib\net9.0\WinRT.Runtime.dll" />
		<!-- Modules build Core without the app version too, so a publish builds it once; modules bind to Core by name, not version (Shell/ModuleHost.cs). -->
		<ProjectReference Include="Core\Lokn.Core.csproj" GlobalPropertiesToRemove="Version" />
		<!-- The relay is its own server project, never part of Loom. -->
		<Compile Remove="Core\**\*.cs;tests\**\*.cs;Modules\**\*.cs;Relay\**\*.cs" />
		<None Remove="Relay\**" />
		<Content Remove="Relay\**" />
		<!-- The source-module compiler is part of the host; every other module is its own reloadable DLL. -->
		<Compile Include="Modules\Hotload\**\*.cs" />
		<EmbeddedResource Include="Modules\Hotload\ModuleGuide.md" LogicalName="ModuleGuide.md" />
		<EmbeddedResource Include="assets\brand\loom-256.png" LogicalName="Loom.png" />
		<!-- Tern's theme catalog, extracted from tern.exe; see ThemeCatalog. -->
		<EmbeddedResource Include="Shell\Theming\TernThemes.json" LogicalName="TernThemes.json" />
		<InternalsVisibleTo Include="Lokn.Tests" />
	</ItemGroup>
	<ItemGroup>
		<!-- Built with the application but never referenced by it: a referenced module could not be reloaded.
		     Each module keeps its own <Version>, so the app version a publish passes in (-p:Version) is removed for them. -->
		<ProjectReference Include="Modules\Editor\Lokn.Modules.Editor.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Files\Lokn.Modules.Files.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Markdown\Lokn.Modules.Markdown.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Omp\Lokn.Modules.Omp.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Conversations\Lokn.Modules.Conversations.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Worktrees\Lokn.Modules.Worktrees.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Terminal\Lokn.Modules.Terminal.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Workspaces\Lokn.Modules.Workspaces.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Projects\Lokn.Modules.Projects.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\GitHub\Lokn.Modules.GitHub.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Git\Lokn.Modules.Git.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Browser\Lokn.Modules.Browser.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Notifications\Lokn.Modules.Notifications.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Setup\Lokn.Modules.Setup.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
		<ProjectReference Include="Modules\Remote\Lokn.Modules.Remote.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Version" />
	</ItemGroup>
</Project>